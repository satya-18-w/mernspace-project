# Local-only demo values. Copy to .env and adjust as needed.
# Real credentials must never be committed.

POSTGRES_USER=mernspace
POSTGRES_PASSWORD=mernspace
POSTGRES_DB=mernspace_auth

# Auth service
REFRESH_TOKEN_SECRET=change-me-local-refresh-secret

# Public URLs used by frontends and CORS
PUBLIC_CLIENT_URL=http://localhost:8080
PUBLIC_ADMIN_URL=http://localhost:8080

# Seeded admin account (change the password for anything beyond the local demo)
ADMIN_EMAIL=admin@mernspace.local
ADMIN_PASSWORD=Admin@12345
ADMIN_FIRST_NAME=Demo
ADMIN_LAST_NAME=Admin
TENANT_NAME=Demo Restaurant
TENANT_ADDRESS=1 Demo Street
